package-as: DeltaChess

externals:
  Libs/LibStub:
    url: https://github.com/WoWUIDev/Ace3
    branch: master
    path: LibStub
  Libs/DeltachessFramework:
    url: https://github.com/Deltachaos/deltachess-framework
    branch: main
  Libs/LibMultiplayer:
    url: https://github.com/Deltachaos/LibMultiplayer
    branch: main
  Libs/LibChessMultiplayer:
    url: https://github.com/Deltachaos/LibChessMultiplayer
    branch: main
  Libs/LibDeflate:
    url: https://github.com/SafeteeWoW/LibDeflate
    branch: main
  Libs/LibSerialize:
    url: https://github.com/rossnichols/LibSerialize
    branch: main
  Libs/LibCrypto:
    url: https://github.com/Deltachaos/LibCrypto
    branch: main
  Libs/LibUnitWow:
    url: https://github.com/Deltachaos/LibUnitWow
    branch: main

ignore:
  - tests
  - Libs/LibUnitWow
  - Libs/DeltachessFramework/bin
  - Libs/DeltachessFramework/tests
  - Libs/DeltachessFramework/README.md
